{
  "name": "mcpocketafk-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend bot engine for MCPocketAFK",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mineflayer": "4.20.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
